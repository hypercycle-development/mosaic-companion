{
  "name": "mosaic-companion",
  "description": "Mosaic Companion Application",
  "version": "0.1.9",
  "main": "dist/main/main.js",
  "author": "hypercycle",
  "scripts": {
    "dev": "vite",
    "build:electron": "node esbuild.config.mjs",
    "build:renderer": "vite build",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:linux": "electron-forge make --platform linux",
    "make:linux:x64": "electron-forge make --platform linux --arch x64",
    "make:linux:arm64": "electron-forge make --platform linux --arch arm64",
    "make:mac": "electron-forge make --platform darwin",
    "make:mac:x64": "electron-forge make --platform darwin --arch x64",
    "make:mac:arm64": "electron-forge make --platform darwin --arch arm64",
    "make:win": "electron-forge make --platform win32",
    "make:win:x64": "electron-forge make --platform win32 --arch x64",
    "make:win:arm64": "electron-forge make --platform win32 --arch arm64",
    "deploy": "electron-forge publish",
    "deploy:x64": "electron-forge publish --arch x64",
    "deploy:arm64": "electron-forge publish --arch arm64",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist release node_modules/.vite",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "dependencies": {
    "@extism/extism": "^2.0.0-rc13",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "@monaco-editor/react": "^4.7.0",
    "@xenova/transformers": "^2.17.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^3.6.0",
    "electron-squirrel-startup": "^1.0.1",
    "google-auth-library": "^10.5.0",
    "googleapis": "^170.0.0",
    "gtoken": "^8.0.0",
    "jwa": "^2.0.1",
    "jws": "^4.0.1",
    "lucide-react": "^0.562.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "open": "^11.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-is": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-toastify": "^11.0.5",
    "recharts": "^3.7.0",
    "remark-breaks": "^4.0.0",
    "semver": "^7.7.3",
    "server-destroy": "^1.0.1",
    "viem": "^2.46.3",
    "ws": "^8.18.0",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron-forge/publisher-s3": "^7.11.1",
    "@playwright/test": "^1.58.2",
    "@reforged/maker-appimage": "^5.1.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@types/server-destroy": "^1.0.4",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.2.3",
    "electron": "^39.3.0",
    "esbuild": "^0.27.2",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
