{
  "name": "mosaic-companion",
  "version": "0.0.39",
  "description": "Mosaic Companion Application",
  "main": "main.js",
  "type": "module",
  "author": "hypercycle",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "vite build && electron main.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist release node_modules/.vite",
    "clean:all": "npm run clean && rm -rf node_modules package-lock.json",
    "build:linux": "npm run build && electron-builder --linux --x64 --arm64",
    "build:linux:x64": "npm run build && electron-builder --linux --x64",
    "build:linux:arm64": "npm run build && electron-builder --linux --arm64",
    "build:mac": "npm run build && electron-builder --mac --universal",
    "build:mac:x64": "npm run build && electron-builder --mac --x64",
    "build:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "build:win": "npm run build && electron-builder --win --x64 --arm64",
    "build:win:x64": "npm run build && electron-builder --win --x64",
    "build:win:arm64": "npm run build && electron-builder --win --arm64",
    "build:all": "npm run build:linux && npm run build:mac && npm run build:win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "electron-updater": "^6.7.3",
    "es-object-atoms": "^1.1.1",
    "google-auth-library": "^10.5.0",
    "googleapis": "^170.0.0",
    "gtoken": "^8.0.0",
    "jwa": "^2.0.1",
    "jws": "^4.0.1",
    "lucide-react": "^0.562.0",
    "math-intrinsics": "^1.1.0",
    "gopd": "^1.2.0",
    "es-define-property": "^1.0.1",
    "call-bind-apply-helpers": "^1.0.2",
    "es-errors": "^1.3.0",
    "function-bind": "^1.1.2",
    "get-proto": "^1.0.1",
    "has-symbols": "^1.1.0",
    "hasown": "^2.0.2",
    "open": "^11.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-toastify": "^11.0.5",
    "server-destroy": "^1.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "com.mosaic.companion",
    "productName": "Mosaic Companion",
    "asar": true,
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**"
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "Mosaic-Companion-${version}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "main.js",
      "updater.js",
      "settings.js",
      "preload.js",
      "gmail-auth.js",
      "gmail-service.js",
      "utils/**/*",
      "config/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "publish": {
      "provider": "s3",
      "bucket": "mosaic-release",
      "region": "us-east-2",
      "path": "/releases"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "default",
      "identity": "-",
      "mergeASARs": true,
      "x64ArchFiles": "**/app.asar.unpacked/node_modules/{onnxruntime-node,sharp}/**/*"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "hern@hypercycle.ai"
    }
  }
}