# Dependencies
node_modules

# Bun
bun.lockb

# Build outputs
dist/
out/
build/
release/
*.asar
tmp_static/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Environment files
.env
.env.local
.env.*.local
.env.test

# Testing
coverage/

# Misc
*.pem
.cache/

# Gmail OAuth credentials (keep private)
config/gmail-credentials.json
# agent files
.github/copilot-instructions.md
.github/skills/
project_dump.txt

*.resolved.md
*.plan.md

# Runtime output from addon dev fixtures (tests/addons/*/) — the
# addonAPI.files jail (addons/<id>/data/) regenerates this on every test run.
tests/addons/*/data/

# Local Claude Code settings
.claude/

# Key material — never committed, in any form. Test keys included: a private
# key in a repo is a private key on the internet the moment the repo is public,
# and git history keeps it there afterwards. Test keys are generated offline by
# the same ceremony as production and kept outside any working tree.
*.pem
*.key
*-signing-key.json

# Dev-corner installs write addonAPI.files storage into the example itself.
examples/*/data/
